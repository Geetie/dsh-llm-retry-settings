{
  "name": "dsh-llm-retry-watchdog",
  "version": "0.2.0",
  "description": "DSH 插件：LLM 重试耗尽后的看门狗——瞬时错误按 2→5→15→30 分钟升级退避持续补投「继续」，直到恢复/人工接手/硬上限。fork 自 dsh-llm-retry-settings。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "llm",
    "retry",
    "auto-retry",
    "auto-continue",
    "max-tokens",
    "settings",
    "deepseek",
    "watchdog",
    "auto-resume",
    "backoff"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.1.6-alpha.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Geetie/dsh-llm-retry-watchdog.git"
  },
  "homepage": "https://github.com/Geetie/dsh-llm-retry-watchdog",
  "bugs": {
    "url": "https://github.com/zeng6125-rgb/dsh-llm-retry-settings/issues"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.6-alpha.1"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}